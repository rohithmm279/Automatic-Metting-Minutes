# LLM Provider Configuration:
# Set GROQ_API_KEY to use Groq cloud inference (recommended for Render deployment)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama local fallback (used if GROQ_API_KEY is unset)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Gemini configuration (research/evaluation pipeline)
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_KEY_MODE=auto

# Server & Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEETING_TWO_PASS=false
PORT=8000
